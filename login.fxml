<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="LoginController"
      alignment="CENTER" spacing="14"
      style="-fx-background-color: #f4f6f9;">
    <padding><Insets top="40" right="50" bottom="40" left="50"/></padding>

    <Label text="MyExpense Tracker"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2E75B6;"/>
    <Label text="Sign in to your account"
           style="-fx-font-size: 13px; -fx-text-fill: #666;"/>

    <Label text="Username" style="-fx-font-size: 13px;"/>
    <TextField fx:id="usernameField" promptText="Enter username" maxWidth="300"/>

    <Label text="Password" style="-fx-font-size: 13px;"/>
    <PasswordField fx:id="passwordField" promptText="Enter password" maxWidth="300"/>

    <Label fx:id="errorLabel" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;"/>

    <Button text="Login" onAction="#handleLogin" maxWidth="300"
            style="-fx-background-color: #2E75B6; -fx-text-fill: white;
                   -fx-font-size: 14px; -fx-pref-height: 36px; -fx-background-radius: 6;"/>

    <HBox alignment="CENTER" spacing="6">
        <Label text="No account?" style="-fx-text-fill: #666;"/>
        <Button text="Register" onAction="#handleGoRegister"
                style="-fx-background-color: transparent; -fx-text-fill: #2E75B6;
                       -fx-underline: true; -fx-cursor: hand; -fx-padding: 0;"/>
    </HBox>
</VBox>
