<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="DashboardController"
            style="-fx-background-color: #f4f6f9;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #2E75B6; -fx-padding: 14 24 14 24;">
            <Label text="MyExpense Tracker"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" style="-fx-text-fill: white;"/>
            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: white; -fx-text-fill: #2E75B6;
                           -fx-font-weight: bold; -fx-background-radius: 6;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="24">
            <padding><Insets top="50" right="40" bottom="40" left="40"/></padding>

            <Label text="Dashboard"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;"/>

            <HBox spacing="24" alignment="CENTER">
                <VBox alignment="CENTER" spacing="8"
                      style="-fx-background-color: white; -fx-background-radius: 10;
                             -fx-padding: 28; -fx-min-width: 180;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),8,0,0,2);">
                    <Label text="Total Expenses" style="-fx-text-fill: #888;"/>
                    <Label fx:id="totalLabel" text="RM 0.00"
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2E75B6;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="8"
                      style="-fx-background-color: white; -fx-background-radius: 10;
                             -fx-padding: 28; -fx-min-width: 180;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),8,0,0,2);">
                    <Label text="Records" style="-fx-text-fill: #888;"/>
                    <Label fx:id="countLabel" text="0"
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                </VBox>
            </HBox>

            <Button text="View / Manage Expenses" onAction="#handleViewExpenses"
                    style="-fx-background-color: #2E75B6; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-pref-height: 42px; -fx-pref-width: 220px;
                           -fx-background-radius: 8;"/>
        </VBox>
    </center>
</BorderPane>
