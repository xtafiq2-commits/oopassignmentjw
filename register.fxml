<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="RegisterController"
      alignment="CENTER" spacing="12"
      style="-fx-background-color: #f4f6f9;">
    <padding><Insets top="40" right="50" bottom="40" left="50"/></padding>

    <Label text="Create Account"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2E75B6;"/>

    <Label text="Username" style="-fx-font-size: 13px;"/>
    <TextField fx:id="usernameField" promptText="Choose a username" maxWidth="300"/>

    <Label text="Email" style="-fx-font-size: 13px;"/>
    <TextField fx:id="emailField" promptText="your@email.com" maxWidth="300"/>

    <Label text="Password" style="-fx-font-size: 13px;"/>
    <PasswordField fx:id="passwordField" promptText="Choose a password" maxWidth="300"/>

    <Label text="Confirm Password" style="-fx-font-size: 13px;"/>
    <PasswordField fx:id="confirmField" promptText="Repeat password" maxWidth="300"/>

    <Label fx:id="errorLabel" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;"/>

    <Button text="Register" onAction="#handleRegister" maxWidth="300"
            style="-fx-background-color: #2E75B6; -fx-text-fill: white;
                   -fx-font-size: 14px; -fx-pref-height: 36px; -fx-background-radius: 6;"/>

    <HBox alignment="CENTER" spacing="6">
        <Label text="Already have an account?" style="-fx-text-fill: #666;"/>
        <Button text="Login" onAction="#handleGoLogin"
                style="-fx-background-color: transparent; -fx-text-fill: #2E75B6;
                       -fx-underline: true; -fx-cursor: hand; -fx-padding: 0;"/>
    </HBox>
</VBox>
