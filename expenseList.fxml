<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="ExpenseListController"
            style="-fx-background-color: #f4f6f9;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #2E75B6; -fx-padding: 14 24 14 24;">
            <Button text="← Back" onAction="#handleBack"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                           -fx-underline: true; -fx-cursor: hand;"/>
            <Label text="Expense List"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

            <HBox spacing="10">
                <Button text="+ Add"    onAction="#handleAdd"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;
                               -fx-pref-height: 34px; -fx-background-radius: 6;"/>
                <Button text="✎ Edit"   onAction="#handleEdit"
                        style="-fx-background-color: #e67e22; -fx-text-fill: white;
                               -fx-pref-height: 34px; -fx-background-radius: 6;"/>
                <Button text="✕ Delete" onAction="#handleDelete"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                               -fx-pref-height: 34px; -fx-background-radius: 6;"/>
            </HBox>

            <TableView fx:id="expenseTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"          text="ID"          prefWidth="50"/>
                    <TableColumn fx:id="colDate"        text="Date"        prefWidth="110"/>
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="280"/>
                    <TableColumn fx:id="colCategory"    text="Category"    prefWidth="130"/>
                    <TableColumn fx:id="colAmount"      text="Amount (RM)" prefWidth="120"/>
                </columns>
                <placeholder><Label text="No expenses yet. Click Add to get started."/></placeholder>
            </TableView>

            <HBox alignment="CENTER_RIGHT">
                <Label fx:id="totalLabel" text="Total: RM 0.00"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2E75B6;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
